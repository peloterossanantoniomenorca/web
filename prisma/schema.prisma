generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PlayerStatus {
  ACTIVE
  INACTIVE
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Player {
  id           String       @id @default(cuid())
  firstName    String
  lastName     String
  fullName     String
  jerseyNumber Int
  position     String
  photoUrl     String?
  status       PlayerStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  payments     Payment[]

  @@index([status])
  @@index([fullName])
}

model PaymentType {
  id          String    @id @default(dbgenerated("gen_random_uuid()::text"))
  description String    @unique
  amount      Decimal   @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  payments    Payment[]
}

model Payment {
  id              String        @id @default(cuid())
  playerId        String
  paymentDate     DateTime
  voucherUrl      String
  voucherFileName String
  voucherFileType String
  amount          Decimal?      @db.Decimal(10, 2)
  status          PaymentStatus @default(PENDING)
  paymentTypeId   String?
  pichangaDate    DateTime?     @db.Timestamptz(6)
  createdAt       DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  player          Player        @relation(fields: [playerId], references: [id], onDelete: Restrict)
  paymentType     PaymentType?  @relation(fields: [paymentTypeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([playerId, paymentDate])
  @@index([status])
  @@index([paymentTypeId])
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TipoEgreso {
  idTipEgreso String   @id @default(cuid())
  descripcion String

  egresos Egreso[]

  @@map("TipoEgreso")
}

model Egreso {
  id                String     @id @default(cuid())
  idTipEgreso       String
  fecha             DateTime   @db.Timestamptz(6)
  monto             Decimal    @db.Decimal(12, 2)
  responsableEgreso String
  voucher           String?
  voucherUrl        String?
  voucherFileName   String?
  voucherFileType   String?

  tipoEgreso TipoEgreso @relation(fields: [idTipEgreso], references: [idTipEgreso], onUpdate: Cascade, onDelete: Restrict)

  @@index([idTipEgreso])
  @@index([fecha])
  @@map("Egreso")
}
